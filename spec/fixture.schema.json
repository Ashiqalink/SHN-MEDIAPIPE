{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixtureVersion": {
      "const": 1
    },
    "area": {
      "enum": [
        "acceptance",
        "schema",
        "expressions",
        "lint",
        "simulation",
        "roundtrip",
        "save",
        "rng"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "input": {
            "type": "object"
          },
          "expect": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "input",
          "expect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fixtureVersion",
    "area",
    "cases"
  ],
  "additionalProperties": false
}
